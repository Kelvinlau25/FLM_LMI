<script>
    var getNewDataTimer = null;

    function getNewData() {
        clearTimeout(getNewDataTimer);
        getNewDataTimer = setTimeout(function () {
            var year = document.getElementById("YEAR").value;
            var month = document.getElementById("MONTH").value;

            var mib = {
                YEAR: year,
                MONTH: month
            };

            console.log(mib)

            $.ajax({
                type: 'POST',
                url: '@Url.Action("FILM_LMI_PRODUCTIVITY_TARGET")',
                data: JSON.stringify(mib),
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    console.log(data)
                    $('#grid').html(data)
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    console.log(xhr)
                    console.log(ajaxOptions)
                    console.log(thrownError)
                }
            });
        }, 300);
    }
</script>
<script>
    function submitForm() {

        var YEAR = document.getElementById("YEAR").value;
        var MONTH = document.getElementById("MONTH").value;

        var SDATE = new Array();
        var TARGET1 = new Array();
        var TARGET2 = new Array();
        var TARGET3 = new Array();

        var oInputs = new Array();
        oInputs = document.getElementsByTagName('input');

        for (i = 0; i < oInputs.length; i++) {
            if (oInputs[i].type == 'text') {
                if (oInputs[i].id.includes('txtTarget_')) {
                    var split = oInputs[i].id.split('_');
                    var target = split[1];
                    var strDate = split[2];

                    // date
                    var year = strDate.substring(0, 4);
                    var month = strDate.substring(4, 6);
                    var day = strDate.substring(6, 8);

                    var date = new Date(year, month-1, day);

                    if (SDATE.indexOf(date.toISOString()) === -1) {
                        SDATE.push(date.toISOString());
                    }

                    if (target == "F1") {
                        TARGET1.push(oInputs[i].value);
                    }

                    if (target == "F2") {
                        TARGET2.push(oInputs[i].value);
                    }

                    if (target == "F3") {
                        TARGET3.push(oInputs[i].value);
                    }

                }
            }
        }
        var error = 'N';
        var LMI_PRODUCTIVITY_TARGET = new Array();

        for (i = 0; i < SDATE.length; i++) {
            var json = {
                "SDATE": SDATE[i],
                "TARGET1": TARGET1[i],
                "TARGET2": TARGET2[i],
                "TARGET3": TARGET3[i]
            }

            LMI_PRODUCTIVITY_TARGET.push(json);
        }

        console.log(LMI_PRODUCTIVITY_TARGET);

        $.ajax({
		        url: "@Url.Action("FILM_LMI_PRODUCTIVITY_TARGET_MAINT")",
		        type: "POST",
                data: JSON.stringify(LMI_PRODUCTIVITY_TARGET),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
                success: function (data) {
                    if (data.RESULT != "OK") {
                        console.log(data);
                        alert("Record failed to save.");
                        return;
                    }
                    alert('Record save successfully.');
		        }
        });
    }
</script>
