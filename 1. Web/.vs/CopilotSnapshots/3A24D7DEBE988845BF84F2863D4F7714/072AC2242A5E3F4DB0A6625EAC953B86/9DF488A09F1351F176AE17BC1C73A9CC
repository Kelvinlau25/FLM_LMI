<div class="container-fluid">
    <div class="row">
        <div id="grid" style="margin-left:15px;">

            @{
                Html.RenderPartial("_DailyPlanBudgetPartial");
            }
        </div>
    </div>
    <div class="row">
        <div class="col-sm-2">
            <button onclick="submitForm();" class="btn btn-primary pull-right">Save</button>
        </div>
    </div>
    <br />
    <br />
