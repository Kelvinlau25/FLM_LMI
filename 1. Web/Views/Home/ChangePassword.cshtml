@model HomeModel.ChangePasswordModel

@{
    var url = @Url.Action("Menu", "Home").ToString();
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}

<h2>
    Change Password
</h2>
<hr />
@if (ViewData["Message"] != null)
{


    if (ViewData["MessageType"].ToString()[0] == 'E')
    {
        <div class="alert alert-danger " role="alert">
            @ViewData["Message"].ToString()
        </div>
    }

    if (ViewData["MessageType"].ToString()[0] == 'Y')
    {
        <div class="alert alert-success " role="alert">
            @ViewData["Message"].ToString()
        </div>
    }
}
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="col-100">
        <div class="col-md-8">
            @Html.LabelFor(a => a.OLD_PASSWORD)
        </div>

        <div class="col-md-8">
            <div class="form-group">
                @Html.PasswordFor(a => a.OLD_PASSWORD, new { @class = "form-control" })
                @Html.ValidationMessageFor(a => a.OLD_PASSWORD)
            </div>
        </div>

        <div class="col-md-8">
            @Html.LabelFor(a => a.NEW_PASSWORD)
        </div>

        <div class="col-md-8">
            <div class="form-group">
                @Html.PasswordFor(a => a.NEW_PASSWORD, new { @class = "form-control" })
                @Html.ValidationMessageFor(a => a.NEW_PASSWORD)
            </div>
        </div>

        <div class="col-md-8">
            @Html.LabelFor(a => a.CONFIRM_NEW_PASSWORD)
        </div>

        <div class="col-md-8">
            <div class="form-group">
                @Html.PasswordFor(a => a.CONFIRM_NEW_PASSWORD, new { @class = "form-control" })
                @Html.ValidationMessageFor(a => a.CONFIRM_NEW_PASSWORD)
            </div>
        </div>

        <div class="col-md-8">
            <input id="Submit" type="submit" name="ActionType" value="Submit" class="btn btn-primary" />
            @*@Html.BackButton(url)*@
        </div>
    </div>
}

@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
        alert("@ViewBag.Result");
        @*//var url = '@Url.Action("UserRegistration", "Mstmain")';*@
        //window.location.href = url;
        </script>
    }
}

