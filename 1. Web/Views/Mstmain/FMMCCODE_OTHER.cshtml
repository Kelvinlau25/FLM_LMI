<script>
var getNewDataTimer = null;

function getNewData() {
    clearTimeout(getNewDataTimer);
    getNewDataTimer = setTimeout(function () {
    var year = document.getElementById("YEAR").value;
    var month = document.getElementById("MONTH").value;

    var mib = {
            //ACTIONTYPE: "View",
            YEAR: year,
            MONTH: month
        };

        console.log(mib)

        $.ajax({
            type: 'POST',
            url: '@Url.Action("FMMCCODE_OTHER")',
            data: '{"model": ' + JSON.stringify(mib) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                console.log(data)
                //alert("Record successfully saved!")
                $('#grid').html(data)
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
            }
        });
        }, 300);
    }
</script>
<script>
    function submitForm() {

        var YEAR = document.getElementById("YEAR").value;
        var MONTH = document.getElementById("MONTH").value;

        var YEAR_MONTH = new Array();
        var FMMCCODE = new Array();
        var B_BUDGET = new Array();
        var C_WASTE = new Array();
        var FIXED_COST = new Array();

        var oInputs = new Array();
        oInputs = document.getElementsByTagName('input');

        for (i = 0; i < oInputs.length; i++) {
            if (oInputs[i].type == 'text') {
                if (oInputs[i].id.includes('txtTarget_')) {
                    var split = oInputs[i].id.split('_');
                    var target = split[1];
                    var fmmccode = split[2];

                    YEAR_MONTH.push(YEAR + '-' + MONTH);

                    if (FMMCCODE.indexOf(fmmccode) === -1) {
                        FMMCCODE.push(fmmccode);
                    }

                    if (target == "C") {
                        C_WASTE.push(oInputs[i].value);
                    }

                    if (target == "B") {
                        B_BUDGET.push(oInputs[i].value);
                    }

                    if (target == "F") {
                        FIXED_COST.push(oInputs[i].value);
                    }

                }
            }
        }
        var error = 'N';
        var LMI_PRODUCTIVITY_TARGET = new Array();

        for (i = 0; i < FMMCCODE.length; i++) {
            var json = {
                "YEAR_MONTH": YEAR_MONTH[i],
                "FMMCCODE": FMMCCODE[i],
                "C_WASTE": C_WASTE[i],
                "B_BUDGET": B_BUDGET[i],
                "FIXED_COST": FIXED_COST[i]
            }

            LMI_PRODUCTIVITY_TARGET.push(json);
        }

        console.log(LMI_PRODUCTIVITY_TARGET);

        $.ajax({
		        url: "@Url.Action("FMMCCODE_OTHER_MAINT")",
		        type: "POST",
                data: JSON.stringify(LMI_PRODUCTIVITY_TARGET),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
                success: function (data) {
                    if (data.RESULT != "OK") {
                        console.log(data);
                        alert("Record failed to save.");
                        return;
                    }
		        }
        });

        if (error == 'N') {
            alert('Record save successfully.');
        } else {
            alert('Record failed to save.');
        }
    }
</script>
