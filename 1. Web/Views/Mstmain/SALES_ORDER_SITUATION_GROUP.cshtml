<div class="form-horizontal">
    <input type="hidden" name="action" id="action" value="1" />
    <div class="form-group row">
        <label for="PROD_LINE" class="col-md-2 col-form-label">Prod Line</label>
        <div class="col-md-2">
            @(Html.DropDownListFor(model => model.PROD_LINE, new SelectList(ViewBag.ProdLineDDL), new { @class = "form-control smallDDL" }))
        </div>
    </div>
    <div class="form-group row">
        <label for="GROUP_NAME" class="col-md-2 col-form-label">Group Name</label>
        <div class="col-md-5">
            @Html.EditorFor(model => model.GROUP_NAME, new { htmlAttributes = new { @class = "form-control smallDDL" } })
        </div>
    </div>
    <div class="form-group row">
        <label for="RPT_GROUP" class="col-md-2 col-form-label">Report Group</label>
        <div class="col-md-5">
            @(Html.DropDownListFor(model => model.RPT_GROUP, new SelectList(ViewBag.ReportGroupDDL), new { @class = "form-control smallDDL" }))
        </div>
    </div>
    <input type="submit" class="btn btn-primary " value="Submit"  onclick="submitForm()"/>
</div>
<div id="grid">
    @{
        Html.RenderPartial("_SalesOrderSituationGroupPartial");
    }
</div>
<script>
    function submitForm() {

        var prodLine = document.getElementById("PROD_LINE").value;
        var grpName = document.getElementById("GROUP_NAME").value;
        var rptGrp = document.getElementById("RPT_GROUP").value;

        var lmi = {
            ID_LMI_SALES_GROUP: "0",
            ACTION: "1",
            PROD_LINE: prodLine,
            GROUP_NAME: grpName,
            RPT_GROUP: rptGrp
        };

        $.ajax({
            type: 'POST',
            url: '@Url.Action("SALES_ORDER_SITUATION_GROUP_MAINT")',
            data: '{"model": ' + JSON.stringify(lmi) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                //$('#grid').html(data)
                console.log(data)
                //alert("Record successfully saved!")
                $('#grid').html(data)
                ////location.reload();
                //console.log("test")
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
                //alert('Error!'+' '+ex);
            }
        });
    }
</script>
