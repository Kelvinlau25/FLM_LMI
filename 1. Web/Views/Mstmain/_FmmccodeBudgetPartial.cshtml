@using MstMainModel
@model MM_FMMCCODE_BUDGET
<script src="~/Scripts/Main.js"></script>

<table class="table">
    <thead>
        <tr class="head">
            <th class="target-date">PROD</th>
            <th class="target-input">Budget</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.LIST_LMI_FMMCCODE_BUDGET)
        {
            <tr>
                <td class="target-date">@item.PROD</td>
                <td class="target-input"><input class="onlyNumber" value="@item.BUDGET1" id="txtTarget_B_@item.PROD" /></td>
            </tr>
        }
    </tbody>
</table>
