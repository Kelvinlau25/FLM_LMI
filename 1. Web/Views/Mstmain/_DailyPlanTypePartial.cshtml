@using MstMainModel
@model MM_DAILY_PLAN_TYPE
<script src="~/Scripts/Main.js"></script>

<table class="table">
    <thead>
        <tr class="head">
            <th class="target-date">THICK</th>
            <th class="target-date">TYPE</th>
            <th class="target-input">Plan</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.LIST_LMI_DAILY_PLAN_TYPE)
        {
            <tr>
                <td class="target-date">@item.THICK</td>
                <td class="target-date">@item.TYPE</td>
                <td class="target-input"><input class="onlyNumber" value="@item.PLAN" id="txtTarget_@(item.THICK)_@(item.TYPE)" /></td>
            </tr>
        }
    </tbody>
</table>
