@using MstMainModel
@model MM_LMI_TARGET
<script src="~/Scripts/Main.js"></script>

<table class="table">
    <thead>
        <tr class="head">
            <th class="target-date"></th>
            <th class="target-input"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.LIST_LMI_TARGET)
        {
            <tr>
                <td class="target-date">@item.FMMCCODE</td>
                <td class="target-input"><input class="onlyNumber" value="@item.TARGET" id="txtTarget_@item.FMMCCODE" /></td>
            </tr>
        }
    </tbody>
</table>
