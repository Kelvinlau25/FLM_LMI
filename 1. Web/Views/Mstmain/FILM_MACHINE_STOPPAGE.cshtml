@using (Html.BeginForm("FILM_MACHINE_STOPPAGE", "Mstmain", FormMethod.Post, new { @class = "form-horizontal" }))
{
    <div class="form-group">
        <label for="YEAR" class="col-md-1 control-label" style="padding-right:0px;padding-left:0px">Period :</label>
        <div class="col-md-3">
            @Html.EditorFor(model => model.PERIOD, new { htmlAttributes = new { @class = "form-control form-control-sm", @type = "date", @onchange = "getNewData()" } })
        </div>
        @*<div class="col-md-3">
                <button type="submit" class="btn btn-primary">View</button>
            </div>*@
    </div>
}

<div class="container-fluid">
    <div class="row">
        <div id="grid" style="margin-left:15px;">
