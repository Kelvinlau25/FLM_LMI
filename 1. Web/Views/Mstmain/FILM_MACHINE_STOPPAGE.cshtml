    </div>
</div>

@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
            alert('@ViewBag.Result');
        </script>
    }
}
<script>
    function getNewData() {

        var year = document.getElementById("PERIOD").value;


        var mib = {
            //ACTIONTYPE: "View",
            PERIOD: year
        };

        console.log(mib)

        $.ajax({
            type: 'POST',
            url: '@Url.Action("FILM_MACHINE_STOPPAGE")',
            data: '{"model": ' + JSON.stringify(mib) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                console.log(data)
                //alert("Record successfully saved!")
                $('#grid').html(data)
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
            }
        });
    }
</script>
<script>
    function submitForm() {


        var SDATE = new Array();
        var ITEM = new Array();
        var STOPPAGE_MINUTE = new Array();

        var oInputs = new Array();
        oInputs = document.getElementsByTagName('input');

        var date = document.getElementById('PERIOD').value;

        var PERIOD = date;

        for (i = 0; i < oInputs.length; i++) {

            if (oInputs[i].type == 'text') {

                if (oInputs[i].id.includes('txtBudget_')) {
                    var split = oInputs[i].id.split('_');
                    var target = split[1];

                    if (target == "F1") {
                        ITEM.push("F1")
                        STOPPAGE_MINUTE.push(oInputs[i].value);
                    }

                    if (target == "F2") {
                        ITEM.push("F2")
                        STOPPAGE_MINUTE.push(oInputs[i].value);
                    }

                    if (target == "F3") {
                        ITEM.push("F3")
                        STOPPAGE_MINUTE.push(oInputs[i].value);
                    }

                }
            }
        }

        var error = 'N';
        var LIST_OPR_RATIO_STOPPAGE = new Array();

        for (i = 0; i < oInputs.length; i++) {
            var json = {
                "ITEM": ITEM[i],
                "STOPPAGE_MINUTE": STOPPAGE_MINUTE[i]
            }

            LIST_OPR_RATIO_STOPPAGE.push(json);
        }

        var model = {
            "PERIOD": PERIOD,
            "LIST_OPR_RATIO_STOPPAGE": LIST_OPR_RATIO_STOPPAGE
        }

        console.log(model)

        $.ajax({
		        url: "@Url.Action("FILM_MACHINE_STOPPAGE_MAINT")",
		        type: "POST",
            data: JSON.stringify(model),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
                success: function (data) {
                    if (data.RESULT != "OK") {
                        console.log(data);
                        alert("Record failed to save.");
                        return;
                    }
		        }
        });

        if (error == 'N') {
            alert('Record save successfully.');
        } else {
            alert('Record failed to save.');
        }
    }
</script>
