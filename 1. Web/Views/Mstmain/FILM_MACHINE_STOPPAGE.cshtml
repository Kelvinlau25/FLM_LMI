                grid.Column("", style: "target-date", format: @<text>@item.ITEM</text>),
                grid.Column("Stoppage Time (Minutes)", style: "target-input", format: @<text> <input type="text" class="onlyNumber" value="@item.STOPPAGE_MINUTE.ToString("G9")" id="txtBudget_@item.ITEM" /> </text>))
