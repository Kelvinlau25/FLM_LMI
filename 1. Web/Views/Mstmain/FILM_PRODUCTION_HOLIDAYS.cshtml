<script>
    function getNewData() {

        var year = document.getElementById("YEAR").value;
        var month = document.getElementById("MONTH").value;


        var mib = {
            //ACTIONTYPE: "View",
            YEAR: year,
            MONTH: month
        };

        console.log(mib)

        $.ajax({
            type: 'POST',
            url: '@Url.Action("FILM_PRODUCTION_HOLIDAYS")',
            data: '{"model": ' + JSON.stringify(mib) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                console.log(data)
                //alert("Record successfully saved!")
                $('#grid').html(data)
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
            }
        });
    }
</script>
<script>
    function submitForm() {

        var dateTime = document.getElementById("DATETIME").value;
        var action = document.getElementById("ACTION").value;
        var year = document.getElementById("YEAR").value;
        var month = document.getElementById("MONTH").value;
        //31-oct-2025


        var tpm = {
            ACTION: action,
            YEAR: year,
            MONTH: month,
            DATETIME: dateTime,
            LIST_FILM_PRODUCTION_HOLIDAYS: []
        };

        $.ajax({
            type: 'POST',
            url: '@Url.Action("FILM_PRODUCTION_HOLIDAYS_MAINT")',
            data: '{"model": ' + JSON.stringify(tpm) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $('#grid').html(data)
                console.log(data)
                alert("Record successfully saved!")
                $('#grid').html(data)
                //location.reload();
                console.log("test")
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
                var err = eval("(" + xhr.responseText + ")");
                alert(err.message);
            }
        });
    }
</script>
