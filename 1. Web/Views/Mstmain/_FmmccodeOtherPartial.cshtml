@using MstMainModel
@model MM_FMMCCODE_BUDGET_OTHER
<script src="~/Scripts/Main.js"></script>

<table class="table">
    <thead>
        <tr class="head">
            <th class="target-date"></th>
            <th class="target-input">B BUDGET</th>
            <th class="target-input">C Waste</th>
            <th class="target-input">FIXED COST</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.LIST_LMI_FMMCCODE_BUDGET_OTHER)
        {
            <tr>
                <td class="target-date">@item.FMMCCODE</td>
                <td class="target-input"><input class="onlyNumber" value="@item.B_BUDGET" id="txtTarget_B_@item.FMMCCODE" /></td>
                <td class="target-input"><input class="onlyNumber" value="@item.C_WASTE" id="txtTarget_C_@item.FMMCCODE" /></td>
                <td class="target-input"><input class="onlyNumber" value="@item.FIXED_COST" id="txtTarget_F_@item.FMMCCODE" /></td>
            </tr>
        }
    </tbody>
</table>
