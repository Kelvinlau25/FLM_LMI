@using (Html.BeginForm("FILM_RAW_BALANCE", "Mstmain", FormMethod.Post, new { @class = "form-horizontal" }))
{
    <div class="form-group">
        <label for="YEAR" class="col-md-1 control-label" style="padding-right:0px;padding-left:0px">Period :</label>
        <div class="col-md-3">
            @(Html.DropDownListFor(model => model.YEAR, new SelectList(ViewBag.YearDDL), new { @class = "form-control smallDDL", @onchange = "getNewData()" })) / @(Html.DropDownListFor(model => model.MONTH, new SelectList(ViewBag.MonthDDL), new { @class = "form-control smallDDL", @onchange = "getNewData()" }))
        </div>
    </div>
    <div class="form-group">
        <label for="FMMCCODE" class="col-md-1 control-label" style="padding-right:0px;padding-left:0px">FM :</label>
        <div class="col-md-3">
            @(Html.DropDownListFor(model => model.FMMCCODE, new SelectList(ViewBag.FmmccodeDDL), new { @class = "form-control smallDDL", @onchange = "getNewData()" }))
        </div>
    </div>
    <div class="form-group">
        <label for="PROD" class="col-md-1 control-label" style="padding-right:0px;padding-left:0px">Prod :</label>
        <div class="col-md-3">
            @(Html.DropDownListFor(model => model.PROD, new SelectList(ViewBag.ProdDDL), new { @class = "form-control mediumDDL", @onchange = "getNewData()" }))
        </div>
    </div>
    @*<div class="form-group">
        <div class="col-md-offset-1 col-md-3">
            <button type="submit" class="btn btn-primary">View</button>
        </div>
    </div>*@
}
<div class="container-fluid">
    <div class="row">
        <div id="grid" class="col-md-offset-1">
            @{
                Html.RenderPartial("_FilmRawBalancePartial");
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <button onclick="submitForm();" class="btn btn-primary pull-right">Save</button>
        </div>
    </div>
    <br />
    <br />
</div>
<script>
var getNewDataTimer = null;

function getNewData() {
    clearTimeout(getNewDataTimer);
    getNewDataTimer = setTimeout(function () {
    var year = document.getElementById("YEAR").value;
    var month = document.getElementById("MONTH").value;
    var prod = document.getElementById("PROD").value;

    var fmmmccode = document.getElementById("FMMCCODE").value;


    var mib = {
        YEAR: year,
        MONTH: month,
        PROD: prod,

        FMMCCODE: fmmmccode
    };

    console.log(mib)

    $.ajax({
            type: 'POST',
            url: '@Url.Action("FILM_RAW_BALANCE")',
            data: '{"model": ' + JSON.stringify(mib) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                console.log(data)
                //alert("Record successfully saved!")
                $('#grid').html(data)
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
            }
        });
        }, 300);
    }
</script>
<script>

    function submitForm() {

        var prod = document.getElementById("PROD").value;

        var fmmmccode = document.getElementById("FMMCCODE").value;

        var YEAR = document.getElementById("YEAR").value;
        var MONTH = document.getElementById("MONTH").value;

        var THICK_TYPE = new Array();
        var THICK = new Array();
        var TYPE = new Array();
        var PLAN = new Array();

        var oInputs = new Array();
        oInputs = document.getElementsByTagName('input');

        for (i = 0; i < oInputs.length; i++) {
            if (oInputs[i].type == 'text') {
                if (oInputs[i].id.includes('txtTarget_')) {
                    var split = oInputs[i].id.split('_');
                    var thick = split[1];
                    var type = split[2];

                    if (THICK_TYPE.indexOf(thick+'_'+type) === -1) {
                        THICK_TYPE.push(thick + '_' + type);
                    }

                    PLAN.push(oInputs[i].value);
                }
            }
        }
        var error = 'N';
        var LIST_LMI_RAW_BALANCE = new Array();

        for (var i = 0; i < THICK_TYPE.length; i++) {
            var split = THICK_TYPE[i].split('_');
            var thick = split[0];
            var type = split[1];
            THICK.push(thick);
            TYPE.push(type);
        }

        for (i = 0; i < THICK_TYPE.length; i++) {
            var json = {
                "THICK": THICK[i],
                "TYPE": TYPE[i],
                "PLAN": PLAN[i]
            }

            LIST_LMI_RAW_BALANCE.push(json);
        }

        var modelz = {
            "YEAR": YEAR,
            "MONTH": MONTH,
            "PROD": prod,
            "FMMCCODE": fmmmccode,
            "LIST_LMI_RAW_BALANCE": LIST_LMI_RAW_BALANCE
        }

        console.log(modelz);

        $.ajax({
		        url: "@Url.Action("FILM_RAW_BALANCE_MAINT")",
		        type: "POST",
            data: JSON.stringify(modelz),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
                success: function (data) {
                    if (data.RESULT != "OK") {
                        console.log(data);
                        alert("Record failed to save.");
                        return;
                    }
		        }
        });

        if (error == 'N') {
            alert('Record save successfully.');
        } else {
            alert('Record failed to save.');
        }
    }
</script>