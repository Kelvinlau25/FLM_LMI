    </div>
    <br />
    <br />
</div>
<script>
    function getNewData() {

        var year = document.getElementById("YEAR").value;
        var month = document.getElementById("MONTH").value;

        var mib = {
            //ACTIONTYPE: "View",
            YEAR: year,
            MONTH: month
        };

        console.log(mib)

        $.ajax({
            type: 'POST',
            url: '@Url.Action("FILM_TARGET")',
            data: '{"model": ' + JSON.stringify(mib) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                console.log(data)
                //alert("Record successfully saved!")
                $('#grid').html(data)
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
            }
        });
    }
</script>
<script>
    function submitForm() {

        var YEAR =  document.getElementById("YEAR").value;
        var MONTH = document.getElementById("MONTH").value;

        var FMMCCODE = new Array();
        var TARGET = new Array();

        var oInputs = new Array();
        oInputs = document.getElementsByTagName('input');

        for (i = 0; i < oInputs.length; i++) {
            if (oInputs[i].type == 'text') {
                if (oInputs[i].id.includes('txtTarget_')) {
                    var split = oInputs[i].id.split('_');
                    var fmmccode = split[1];

                    if (FMMCCODE.indexOf(fmmccode) === -1) {
                        FMMCCODE.push(fmmccode);
                    }

                    if (fmmccode == "F1") {
                        TARGET.push(oInputs[i].value);
                    }

                    if (fmmccode == "F2") {
                        TARGET.push(oInputs[i].value);
                    }

                    if (fmmccode == "F3") {
                        TARGET.push(oInputs[i].value);
                    }

                }
            }
        }
        var error = 'N';
        var LMI_PRODUCTIVITY_TARGET = new Array();

        for (i = 0; i < FMMCCODE.length; i++) {
            var json = {
                "FMMCCODE": FMMCCODE[i],
                "TARGET": TARGET[i]
            }

            LMI_PRODUCTIVITY_TARGET.push(json);
        }

        console.log(LMI_PRODUCTIVITY_TARGET);

        var modl = {
            "YEAR": YEAR,
            "MONTH": MONTH,
            "LIST_LMI_TARGET": LMI_PRODUCTIVITY_TARGET
        }

        $.ajax({
		        url: "@Url.Action("FILM_TARGET_MAINT")",
		        type: "POST",
                data: JSON.stringify(modl),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
                success: function (data) {
                    if (data.RESULT != "OK") {
                        console.log(data);
                        alert("Record failed to save.");
                        return;
                    }
		        }
        });

        if (error == 'N') {
            alert('Record save successfully.');
        } else {
            alert('Record failed to save.');
        }
    }
</script>
