@using (Html.BeginForm("DAILY_PLAN_TYPE", "Mstmain", FormMethod.Post, new { @class = "form-horizontal" }))
{
    <div class="form-group">
        <label for="YEAR" class="col-md-1 control-label" style="padding-right:0px;padding-left:0px">PERIOD :</label>
        <div class="col-md-4">
            @(Html.DropDownListFor(model => model.YEAR, new SelectList(ViewBag.YearDDL), new { @class = "form-control smallDDL", @onchange = "getNewData()" })) / @(Html.DropDownListFor(model => model.MONTH, new SelectList(ViewBag.MonthDDL), new { @class = "form-control smallDDL", @onchange = "callChangefunc(this.value)" })) / <select id="DAY" name="DAY" class="form-control smallDDL" onchange = "getNewData()"></select>
        </div>
    </div>
    <div class="form-group">
        <label for="FMMCCODE" class="col-md-1 control-label" style="padding-right:0px;padding-left:0px">FM :</label>
        <div class="col-md-4">
            @(Html.DropDownListFor(model => model.FMMCCODE, new SelectList(ViewBag.FmmccodeDDL), new { @class = "form-control smallDDL", @onchange = "getNewData()" }))
        </div>
    </div>
    @*<div class="form-group">
        <div class="col-md-offset-1 col-md-3">
            <button type="submit" class="btn btn-primary">View</button>
        </div>
    </div>*@
}
<div class="container-fluid">
    <div class="row">
        <div id="grid" style="margin-left:15px;">
            @{
                Html.RenderPartial("_DailyPlanTypePartial");
            }
        </div>
    </div>
    <div class="row">
        <div class="col-sm-2">
            <button onclick="submitForm();" class="btn btn-primary pull-right">Save</button>
        </div>
    </div>
    <br />
    <br />
</div>
<script>
    var getNewDataTimer = null;

    function getNewData() {
        clearTimeout(getNewDataTimer);
        getNewDataTimer = setTimeout(function () {

        var year = document.getElementById("YEAR").value;
        var month = document.getElementById("MONTH").value;
        var day = document.getElementById("DAY").value;

        var fmmmccode = document.getElementById("FMMCCODE").value;


        var mib = {
            //ACTIONTYPE: "View",
            YEAR: year,
            MONTH: month,
            DAY: day,

            FMMCCODE: fmmmccode
        };

        console.log(mib)

        $.ajax({
            type: 'POST',
            url: '@Url.Action("DAILY_PLAN_TYPE")',
            data: '{"model": ' + JSON.stringify(mib) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                console.log(data)
                //alert("Record successfully saved!")
                $('#grid').html(data)
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
            }
        });
        }, 300);
    }
</script>
<script>

    window.onload = function () {
        let dropdown = document.getElementById("DAY");
        let strMonth = document.getElementById("MONTH").value;
        let strYear = document.getElementById("YEAR").value;

        var numOfDays = new Date(strYear, strMonth, 0).getDate();

        dropdown.length = 0;

        dropdown.selectedIndex = 0;

        let option;

        for (var i = 0; i < numOfDays; i++) {
            option = document.createElement('option');
            option.text = (i + 1).pad();
            option.value = (i + 1).pad();
            dropdown.add(option);
        }
    };

    Number.prototype.pad = function (size) {
        var s = String(this);
        while (s.length < (size || 2)) { s = "0" + s; }
        return s;
    }

    function callChangefunc(val) {
        let dropdown = document.getElementById("DAY");
        dropdown.length = 0;

        dropdown.selectedIndex = 0;

        let option;

        var x = document.getElementById("YEAR").value;
        var numOfDays = new Date(x, val, 0).getDate();

        for (var i = 0; i < numOfDays; i++) {
            option = document.createElement('option');
            option.text = (i + 1).pad();
            option.value = (i + 1).pad();
            dropdown.add(option);
        }
        console.log(numOfDays);
        getNewData();
    }

    function submitForm() {

        var YEAR = document.getElementById("YEAR").value;
        var MONTH = document.getElementById("MONTH").value;

        var THICK_TYPE = new Array();
        var THICK = new Array();
        var TYPE = new Array();
        var PLAN = new Array();

        var oInputs = new Array();
        oInputs = document.getElementsByTagName('input');

        for (i = 0; i < oInputs.length; i++) {
            if (oInputs[i].type == 'text') {
                if (oInputs[i].id.includes('txtTarget_')) {
                    var split = oInputs[i].id.split('_');
                    var thick = split[1];
                    var type = split[2];

                    if (THICK_TYPE.indexOf(thick+'_'+type) === -1) {
                        THICK_TYPE.push(thick + '_' + type);
                    }

                    PLAN.push(oInputs[i].value);
                }
            }
        }
        var error = 'N';
        var LMI_DAILY_PLAN_TYPE = new Array();

        for (var i = 0; i < THICK_TYPE.length; i++) {
            var split = THICK_TYPE[i].split('_');
            var thick = split[0];
            var type = split[1];
            THICK.push(thick);
            TYPE.push(type);
        }

        for (i = 0; i < THICK_TYPE.length; i++) {
            var json = {
                "THICK": THICK[i],
                "TYPE": TYPE[i],
                "PLAN": PLAN[i]
            }

            LMI_DAILY_PLAN_TYPE.push(json);
        }

        let strDay = document.getElementById("DAY").value;
        let fmmmccode = document.getElementById("FMMCCODE").value;
        var modelz = {
            "DAY": strDay,
            "YEAR": YEAR,
            "MONTH": MONTH,
            "FMMCCODE": fmmmccode,
            "LIST_LMI_DAILY_PLAN_TYPE": LMI_DAILY_PLAN_TYPE
        }

        $.ajax({
		        url: "@Url.Action("DAILY_PLAN_TYPE_MAINT")",
		        type: "POST",
            data: JSON.stringify(modelz),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
                success: function (data) {
                    if (data.RESULT != "OK") {
                        console.log(data);
                        alert("Record failed to save.");
                        return;
                    }
		        }
        });

        if (error == 'N') {
            alert('Record save successfully.');
        } else {
            alert('Record failed to save.');
        }
    }
</script>