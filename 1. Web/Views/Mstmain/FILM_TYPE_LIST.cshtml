@{
    if (ViewBag.Result != "" && ViewBag.Result != null)
    {
        <script type="text/javascript" language="javascript">
            alert('@ViewBag.Result');
        </script>
    }
}
<script>


    $(document).ready(function () {
    document.getElementById('FMMCCODE').addEventListener('change', function () {
        window.location.href = "@Url.Action("FILM_TYPE_LIST")" + "?FMMCCODE=" + this.value;
    });
    });
    function deleteType(fmmcode, thick, type) {
        console.log(fmmcode + '-' + thick + '-' + type)

        var modelz = {
            "SEQ":"0",
            "THICK": thick,
            "TYPE": type,
            "FMMCCODE": fmmcode,
            "REC_TYPE":"5"
        }

        $.ajax({
		        url: "@Url.Action("FILM_TYPE_LIST_MAINT")",
		        type: "POST",
            data: JSON.stringify(modelz),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
            success: function (data) {
                    console.log(data)
                    if (data.RESULT == "OK") {
                        console.log(data);
                        alert("Record save successfully.");

                        window.location.href = "@Url.Action("FILM_TYPE_LIST")" + "?FMMCCODE=" + data.FMMCODE;
                    }
		        }
        });
    }

    function AddNew() {

        var fmmcode = document.getElementById('FMMCCODE').value;
        var seq = document.getElementById('SEQ').value;
        var thick = document.getElementById('THICK').value;
        var type = document.getElementById('TYPE').value;


        if (!document.getElementById('FMMCCODE').value ||
            !document.getElementById('SEQ').value ||
            !document.getElementById('THICK').value ||
            !document.getElementById('TYPE').value) {

            alert("Input value is empty!")
            return;
        }


        var modelz = {
            FMMCCODE: fmmcode,
            SEQ: seq,
            THICK: thick,
            TYPE: type,
            REC_TYPE:"1",
            LIST_LMI_TYPE: []
        }

        console.log(modelz)

        $.ajax({
		        url: "@Url.Action("FILM_TYPE_LIST_MAINT")",
		        type: "POST",
            data: JSON.stringify(modelz),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
            success: function (data) {
                console.log(data)
                    if (data.RESULT == "OK") {
                        console.log(data);
                        alert("Record saved successfully.");
                        window.location.href = "@Url.Action("FILM_TYPE_LIST")" + "?FMMCCODE=" + data.FMMCODE;
                    }
                //console.log(data)
                //$('#grid').html(data)
		        }
        });
    }

    function submitForm() {

        var THICK_TYPE = new Array();
        var THICK = new Array();
        var TYPE = new Array();
        var PLAN = new Array();

        var oInputs = new Array();
        oInputs = document.getElementsByTagName('input');

        for (i = 0; i < oInputs.length; i++) {
            if (oInputs[i].type == 'text') {
                if (oInputs[i].id.includes('txtTarget_')) {
                    var split = oInputs[i].id.split('_');
                    var thick = split[1];
                    var type = split[2];

                    if (THICK_TYPE.indexOf(thick+'_'+type) === -1) {
                        THICK_TYPE.push(thick + '_' + type);
                    }

                    PLAN.push(oInputs[i].value);
                }
            }
        }
        var error = 'N';
        var LIST_LMI_TYPE = new Array();

        for (var i = 0; i < THICK_TYPE.length; i++) {
            var split = THICK_TYPE[i].split('_');
            var thick = split[0];
            var type = split[1];
            THICK.push(thick);
            TYPE.push(type);
        }

        for (i = 0; i < THICK_TYPE.length; i++) {
            var json = {
                "THICK": THICK[i],
                "TYPE": TYPE[i],
                "PLAN": PLAN[i]
            }

            LIST_LMI_TYPE.push(json);
        }

        var modelz = {
            "FMMCCODE": "@Model.FMMCCODE",
            "REC_TYPE":"3",
            "LIST_LMI_TYPE": LIST_LMI_TYPE
        }

        console.log(modelz)

        $.ajax({
		        url: "@Url.Action("FILM_TYPE_LIST_MAINT2")",
		        type: "POST",
            data: JSON.stringify(modelz),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
            success: function (data) {
                console.log(data)
                    if (data.RESULT == "OK") {
                        console.log(data);
                        alert("Record saved successfully.");
                        return;
                    }
		        }
        });

        //if (error == 'N') {
        //    alert('Record save successfully.');
        //} else {
        //    alert('Record failed to save.');
        //}
    }
</script>
