@using MstMainModel
@model MM_TYPE

@{
    ViewBag.Title = "FILM TYPE LIST SETTING";
    Layout = "~/Views/Shared/_Layout_iFrame.cshtml";
}
<style>
    .smallDDL {
        width: 50% !important;
        min-width: 50%;
    }

    .mediumDDL {
        width: 80% !important;
        min-width: 80%;
    }

    .table {
        width: 30% !important;
    }

    .target-date {
        width: 23.33% !important;
        min-width: 23.33%;
    }

    .target-input {
        width: 30% !important;
        min-width: 30%;
    }

    .table > tbody > tr > td, table > thead > tr > th {
        border: 1px solid #000 !important;
    }

    .table > thead > tr > th {
        text-align: center;
    }

    .table > thead > tr > td {
        text-align: left;
        vertical-align: middle;
    }

    table td {
        position: relative;
    }

        table td button {
            text-align: center;
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            resize: none;
            width: 90%;
            padding: 0.3rem;
            margin: 0.2rem 0.5rem;
        }

        table td input {
            text-align: right;
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            resize: none;
            width: 95%;
            padding: 0.3rem;
            margin: 0.1rem 0.3rem;
        }
</style>
<h2>FILM TYPE LIST SETTING</h2>
<hr />
