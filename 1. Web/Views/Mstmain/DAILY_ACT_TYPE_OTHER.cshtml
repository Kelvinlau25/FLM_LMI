<div class="container-fluid">
    <div class="row">
        <div id="grid" style="margin-left:15px;">
            @{
                Html.RenderPartial("_DailyActTypeOtherPartial");
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <button onclick="submitForm();" class="btn btn-primary pull-right">Save</button>
        </div>
    </div>
    <br />
    <br />
</div>
<script>
    var getNewDataTimer = null;

    function getNewData() {
        clearTimeout(getNewDataTimer);
        getNewDataTimer = setTimeout(function () {

        var year = document.getElementById("YEAR").value;
        var month = document.getElementById("MONTH").value;
        var fmmmccode = document.getElementById("FMMCCODE").value;


        var mib = {
            //ACTIONTYPE: "View",
            YEAR: year,
            MONTH: month,
            FMMCCODE: fmmmccode
        };

        console.log(mib)

        $.ajax({
            type: 'POST',
            url: '@Url.Action("DAILY_ACT_TYPE_OTHER")',
            data: '{"model": ' + JSON.stringify(mib) + '}',
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                console.log(data)
                //alert("Record successfully saved!")
                $('#grid').html(data)
            },
            error: function (xhr, ajaxOptions, thrownError) {
                console.log(xhr)
                console.log(ajaxOptions)
                console.log(thrownError)
            }
        });
        }, 300);
    }
</script>
<script>
    function submitForm() {

        var fmmmccode = document.getElementById("FMMCCODE").value;
        var YEAR = document.getElementById("YEAR").value;
        var MONTH = document.getElementById("MONTH").value;

        var THICK = new Array();
        var TYPE = new Array();
        var THICK_TYPE = new Array();
        var CR_ACT = new Array();
        var BMIX_ACT = new Array();
        var SPEED_PLAN = new Array();

        var oInputs = new Array();
        oInputs = document.getElementsByTagName('input');

        for (i = 0; i < oInputs.length; i++) {
            if (oInputs[i].type == 'text') {
                if (oInputs[i].id.includes('txtTarget_')) {
                    var split = oInputs[i].id.split('_');
                    var target = split[1];
                    var thick = split[2];
                    var type = split[3];

                    var thick_type = thick + '_' + type;
                    if (THICK_TYPE.indexOf(thick_type) === -1) {
                        THICK_TYPE.push(thick_type);
                    }

                    if (target == "C") {
                        CR_ACT.push(oInputs[i].value);
                    }

                    if (target == "B") {
                        BMIX_ACT.push(oInputs[i].value);
                    }

                    if (target == "S") {
                        SPEED_PLAN.push(oInputs[i].value);
                    }

                }
            }
        }

        for (i = 0; i < THICK_TYPE.length; i++) {
            var split = THICK_TYPE[i].split('_');
            var _thick = split[0];
            var _type = split[1];

            THICK.push(_thick);
            TYPE.push(_type);
        }
        var error = 'N';
        var LMI_STOCK_CONTROL_LIST_BUDGET = new Array();

        for (i = 0; i < THICK_TYPE.length; i++) {
            var json = {
                "THICK": THICK[i],
                "TYPE": TYPE[i],
                "CR_ACT": CR_ACT[i],
                "BMIX_ACT": BMIX_ACT[i],
                "SPEED_PLAN": SPEED_PLAN[i]
            }

            LMI_STOCK_CONTROL_LIST_BUDGET.push(json);
        }

        var modl = {
            "YEAR": YEAR,
            "MONTH": MONTH,
            "FMMCCODE": fmmmccode,
            "LIST_LMI_DAILY_ACT_TYPE_OTHER": LMI_STOCK_CONTROL_LIST_BUDGET
        }
        console.log(modl);
        $.ajax({
		        url: "@Url.Action("DAILY_ACT_TYPE_OTHER_MAINT")",
		        type: "POST",
                data: JSON.stringify(modl),
		        contentType: "application/json; charset=utf-8",
		        dataType: "json",
		        error: function (data) {
		            alert("Posting Error. Please contact TMS Administrator.\nCheck next tab for more info.");
                    error = 'Y';

		            var newWindow = window.open();
                    newWindow.document.write(data.responseText);
                    return;
		            },
                success: function (data) {
                    if (data.RESULT != "OK") {
                        console.log(data);
                        alert("Record failed to save.");
                        return;
                    }
		        }
        });

        if (error == 'N') {
            alert('Record save successfully.');
        } else {
            alert('Record failed to save.');
        }
    }
</script>

